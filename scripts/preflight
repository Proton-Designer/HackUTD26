#!/usr/bin/env python3
"""Demo preflight: read-only PASS/FAIL checks against a RUNNING hub. Makes NO Telnyx API calls and changes nothing (GETs + one WS handshake).
Usage: scripts/preflight [--live] [--local URL] [--tunnel URL] [--no-tunnel]
  default = phone-free demo (hub SIM_MODE must be ON). --live = real phone demo (SIM_MODE must be OFF).
  local  = $HUB_URL or http://127.0.0.1:${HUB_PORT:-8000};  tunnel = --tunnel, $PUBLIC_URL, or logs/tunnel_url.txt ($LOGDIR honoured)
  x-hub-token is sent from $HUB_TOKEN if set. Exit 1 if any check FAILs. Stdlib only."""
import argparse, base64, io, json, os, pathlib, socket, ssl, sys, urllib.error, urllib.request, wave
from urllib.parse import urlsplit

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEMO_CALLER = "+12145550199"          # judge number seeded by intel.seed_demo; must route LIVE_GUARD (not blocked) on a fresh demo
results = []

def rec(ok, name, detail=""):
    results.append(ok)
    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  ({detail})" if detail else ""))
    return ok

def get(url, timeout=8, headers=None):
    h = dict(headers or {})
    if os.environ.get("HUB_TOKEN"): h["x-hub-token"] = os.environ["HUB_TOKEN"]
    req = urllib.request.Request(url, headers=h)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, b""
    except Exception as e:
        return 0, type(e).__name__.encode()

def jget(url):
    st, body = get(url)
    try: return st, json.loads(body)
    except Exception: return st, {}

def ws_connects(base, path="/events"):
    """Raw RFC6455 handshake: connected = server answers 101 Switching Protocols. Closes immediately."""
    u = urlsplit(base); tls = u.scheme == "https"
    host, port = u.hostname, u.port or (443 if tls else 80)
    try:
        s = socket.create_connection((host, port), timeout=8)
        if tls: s = ssl.create_default_context().wrap_socket(s, server_hostname=host)
        key = base64.b64encode(os.urandom(16)).decode()
        s.sendall((f"GET {path} HTTP/1.1\r\nHost: {u.netloc}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                   f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        first = s.recv(256).split(b"\r\n", 1)[0].decode(errors="replace"); s.close()
        return " 101 " in first + " ", first
    except Exception as e:
        return False, type(e).__name__

def tunnel_file():
    """F9: current P2 tunnel origin from $LOGDIR/p2_tunnel_url.txt (the hub re-reads it per call), or None."""
    d = pathlib.Path(os.environ.get("LOGDIR") or "logs"); d = d if d.is_absolute() else ROOT / d
    try:
        line = ((d / "p2_tunnel_url.txt").read_text().strip().splitlines() or [""])[0].strip()
    except OSError:
        return None
    sp = urlsplit(line)
    if sp.scheme not in ("https", "http", "wss", "ws") or not sp.hostname or sp.username or sp.password:
        return None
    return f"{'https' if sp.scheme in ('https', 'wss') else 'http'}://{sp.netloc}"

def p2_host():
    """Host:port of the P2 URL the hub uses (shell env, else repo .env; never prints the URL path/query/credentials)."""
    f = tunnel_file()
    if f:
        return urlsplit(f).netloc + " (logs/p2_tunnel_url.txt)"
    vals = {k: os.environ.get(k) for k in ("P2_STT_URL", "P2_BASE")}
    try:
        for ln in (ROOT / ".env").read_text().splitlines():
            k, _, v = ln.partition("=")
            if k.strip() in vals and not vals[k.strip()]:
                vals[k.strip()] = v.strip().strip("\"'")
    except OSError:
        pass
    u = vals.get("P2_STT_URL") or vals.get("P2_BASE")
    return (urlsplit(u).netloc.rsplit("@", 1)[-1] or "?") if u else "no P2_STT_URL/P2_BASE set"

def main():
    ap = argparse.ArgumentParser(); ap.add_argument("--live", action="store_true"); ap.add_argument("--local"); ap.add_argument("--tunnel")
    ap.add_argument("--no-tunnel", action="store_true"); a = ap.parse_args()
    local = (a.local or os.environ.get("HUB_URL") or f"http://127.0.0.1:{os.environ.get('HUB_PORT', '8000')}").rstrip("/")
    tunnel = None
    if not a.no_tunnel and os.environ.get("NO_TUNNEL") != "1":
        tunnel = a.tunnel or os.environ.get("PUBLIC_URL")
        if not tunnel:
            f = pathlib.Path(os.environ.get("LOGDIR") or "logs"); f = (f if f.is_absolute() else ROOT / f) / "tunnel_url.txt"
            tunnel = f.read_text().strip() if f.is_file() else None
        tunnel = tunnel.rstrip("/") if tunnel else None
    print(f"preflight  local={local}  tunnel={tunnel or '(none)'}  mode={'LIVE (real phone)' if a.live else 'phone-free (SIM_MODE)'}\n")

    # 1. hub health
    st, j = jget(local + "/healthz"); rec(st == 200 and j.get("ok") is True, "hub /healthz (local)", f"HTTP {st}")
    if not a.no_tunnel and os.environ.get("NO_TUNNEL") != "1":
        if tunnel:
            st, j = jget(tunnel + "/healthz"); rec(st == 200 and j.get("ok") is True, "hub /healthz (tunnel)", f"HTTP {st}")
        else:
            rec(False, "hub /healthz (tunnel)", "no tunnel URL: pass --tunnel, set PUBLIC_URL, or start run_hub (writes logs/tunnel_url.txt)")

    # 2. /demo/status flags
    st, s = jget(local + "/demo/status")
    if not rec(st == 200 and "flags" in s, "/demo/status readable", f"HTTP {st}"):
        s = {"flags": {}, "pipelines": {}}
    fl, pl = s.get("flags", {}), s.get("pipelines", {})
    sim = bool(fl.get("SIM_MODE"))
    if a.live: rec(not sim, "SIM_MODE is OFF (live phone demo)", f"SIM_MODE={sim}")
    else:      rec(sim, "SIM_MODE is ON (phone-free demo)", f"SIM_MODE={sim}")
    eng = str(fl.get("intel_engine"))
    rec(eng.startswith("nemotron"), "intel_engine is nemotron", eng)
    rec(fl.get("NVIDIA_API_KEY_set") is True, "NVIDIA_API_KEY set on hub", str(fl.get("NVIDIA_API_KEY_set")))
    p2 = pl.get("P2 /detect", {})
    tf = tunnel_file()
    if tf:
        try:   # plain GET: never send the hub token to the P2 host
            with urllib.request.urlopen(tf + "/healthz", timeout=6) as r: st2 = r.status
        except urllib.error.HTTPError as e: st2 = e.code
        except Exception: st2 = 0
        rec(st2 == 200, "P2 tunnel URL file (logs/p2_tunnel_url.txt) reachable", f"host={urlsplit(tf).netloc}, HTTP {st2}" + ("" if st2 == 200 else "; the file is stale: P2 tunnel restarted? update/remove the file"))
    rec(p2.get("remote") == "up", "P2 reachable (P2_STT_URL/P2_BASE healthz)", f"host={p2_host()}, remote={p2.get('remote')}, mounted={p2.get('mounted')}" + ("" if p2.get("remote") == "up" else "; P2 down: no live alerts. Start/restart P2 (bash detection/scripts/run.sh) or arm FALLBACK_DETECT=1"))
    t_ok = fl.get("telnyx_ok")
    rec(t_ok is not False, "telnyx_ok is not false", {None: "no REST call reported yet", True: "true", False: "false: last Telnyx REST call was 401/10009"}[t_ok if t_ok in (None, True, False) else None])

    # simulated webhooks must be loopback-only: via the tunnel they have to be refused (403), never processed
    if tunnel:
        try:
            req = urllib.request.Request(tunnel + "/telnyx/webhook", data=b"{}", method="POST", headers={"x-sim-call": "1", "content-type": "application/json"})
            try: code = urllib.request.urlopen(req, timeout=8).status
            except urllib.error.HTTPError as e: code = e.code
        except Exception as e:
            code = 0
        rec(code == 403, "tunnel refuses x-sim-call webhook (403)", f"HTTP {code}")

    # 3. caller audio
    st, body = get(local + "/demo/caller.wav", timeout=15)
    dur = None
    if st == 200:
        try:
            with wave.open(io.BytesIO(body)) as w: dur = w.getnframes() / w.getframerate()
        except Exception: dur = None
    rec(st == 200 and dur is not None and dur >= 3, "GET /demo/caller.wav 200 + duration >= 3 s", f"HTTP {st}, {dur:.1f}s" if dur else f"HTTP {st}, not a readable WAV")

    # 4. pages (Maria's app is mounted at /app/, the judge page at /app/judge.html)
    for base, label in [(tunnel, "tunnel")] if tunnel else [(local, "local")]:
        st, _ = get(base + "/")            # bare URL: urllib follows the redirect, so a 200 means / -> /app/ works
        rec(st == 200, f"bare / redirects to the app ({label})", f"HTTP {st}")
        for path in ("/app/", "/app/judge.html"):
            st, body = get(base + path); rec(st == 200 and b"<" in body, f"{path} loads ({label})", f"HTTP {st}")

    # 5. websocket
    base = tunnel or local
    ok, first = ws_connects(base); rec(ok, f"WS /events connects ({'tunnel' if tunnel else 'local'})", first[:40])

    # 6. fresh demo state
    st, lk = jget(f"{local}/routing/lookup?from=%2B{DEMO_CALLER[1:]}")
    rec(st == 200 and lk.get("decision") == "LIVE_GUARD", f"demo caller {DEMO_CALLER} routes LIVE_GUARD (no leftover block)", f"HTTP {st}, {lk.get('decision')}")
    st, pb = jget(local + "/protection-log")
    blocked = pb.get("blocked") if st == 200 else None
    rec(st == 200 and blocked == [], "protection log empty (fresh demo)", f"HTTP {st}, {len(blocked) if blocked is not None else '?'} blocked" + ("; run scripts/reset_demo" if blocked else ""))

    bad = results.count(False)
    print(f"\n{len(results) - bad}/{len(results)} PASS" + ("" if not bad else f", {bad} FAIL: fix, then re-run (scripts/reset_demo clears demo state)"))
    sys.exit(1 if bad else 0)

if __name__ == "__main__":
    main()
