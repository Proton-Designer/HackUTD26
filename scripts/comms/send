#!/usr/bin/env bash
# Send a message to another pipeline's agent (GitHub Issues via REST; works with any gh login).
#   bash scripts/comms/send P3 "subject" "body"        new thread to P3   (targets: P1 P2 P3 P4 P4a P4b ALL;
#                                                      P4 reaches both P4a=Kareem intel and P4b=Rayan command center)
#   bash scripts/comms/send P3 "subject" -              same, body read from stdin (long text / quotes)
#   bash scripts/comms/send reply 12 "body" [P3]        reply on thread #12 (optionally also address it to P3)
#   bash scripts/comms/send close 12 "resolution"       close thread #12 with a note
#   bash scripts/comms/send list                        open threads addressed to me or ALL
#   bash scripts/comms/send ping P2                     test message (the receiver's agent should see it within ~1 min)
#   bash scripts/comms/send blast "subject" "body"      📢 announcement to EVERY agent (high priority; shown first)
#   bash scripts/comms/send ack 12 ["on it, ETA 20m"]   acknowledge thread #12 right away (clears the "you owe a reply" block)
#   bash scripts/comms/send done 12 "what landed"       sync (push) first, then post commit SHA + branch on #12 and close it
#   bash scripts/comms/send done P4a "what landed"      same, as a new ✅ READY thread to a pipeline (or ALL)
#   bash scripts/comms/send wait P1 "what I need"       ⛔ ask a pipeline for something you're blocked on; marks you blocked
set -eu
source "$(dirname "$0")/common.sh"
FROM="$(me)"
[ -z "$FROM" ] && { echo "No pipeline identity. Run: bash scripts/comms/setup P1   (P1|P2|P3|P4a|P4b)" >&2; exit 1; }
# Label a thread so the other party receives replies: the thread's sender (if not me) and its recipients.
address_other() {  # $1 = issue number
  local opener; opener=$(gh api "repos/$REPO/issues/$1" --jq '[.labels[].name|select(startswith("from:"))][0] // "" | sub("from:";"")' 2>/dev/null)
  [ -n "$opener" ] && [ "$opener" != "$FROM" ] && gh api "repos/$REPO/issues/$1/labels" -f "labels[]=to:$opener" >/dev/null 2>&1
  return 0
}
sig() { printf '\n\n---\n_from: %s · %s_' "$FROM" "$(date '+%H:%M')"; }
need() { [ "$1" -ge "$2" ] || { sed -n '2,14p' "$0" >&2; exit 1; }; }
acked() { echo "$1" >> "$STATE_DIR/acked_$FROM"; }
new_thread() {  # to subj body extra-label
  local extra=(); [ -n "${4:-}" ] && extra=(-f "labels[]=$4")
  gh api "repos/$REPO/issues" -f title="$2" -f body="${3}$(sig)" -f "labels[]=to:$1" -f "labels[]=from:$FROM" ${extra[@]+"${extra[@]}"} --jq '.html_url'
}
landed() {  # sync, then print a one-line commit reference
  local root br sha; root="$(git rev-parse --show-toplevel)"
  bash "$root/scripts/git/sync" >&2 || { echo "sync failed: fix it, then re-run done" >&2; exit 1; }
  br=$(git rev-parse --abbrev-ref HEAD); sha=$(git rev-parse --short HEAD)
  printf 'commit %s on %s (%s). Get it: bash scripts/git/sync' "$sha" "$br" "$(git log -1 --format=%s | cut -c1-80)"
}
body_of() { if [ "$1" = "-" ]; then cat; else printf '%s' "$1"; fi; }
valid_to() { case "$1" in P1|P2|P3|P4|P4a|P4b|ALL) ;; *) echo "Unknown target '$1' (use $TARGETS)" >&2; exit 1;; esac; }

case "${1:-}" in
  reply)
    need $# 3; n="$2"; body="$(body_of "$3")"; to="${4:-}"
    gh api "repos/$REPO/issues/$n/comments" -f body="${body}$(sig)" --jq '.html_url' >/dev/null
    address_other "$n"
    if [ -n "$to" ]; then valid_to "$to"; gh api "repos/$REPO/issues/$n/labels" -f "labels[]=to:$to" >/dev/null; fi
    acked "$n"; echo "replied on #$n";;
  ack)
    need $# 2; n="$2"; note="${3:-on it}"
    gh api "repos/$REPO/issues/$n/comments" -f body="👍 ACK: ${note}$(sig)" >/dev/null
    address_other "$n"
    acked "$n"; echo "acked #$n";;
  done)
    need $# 3; what="$(body_of "$3")"; ref="$(landed)"
    case "$2" in
      P1|P2|P3|P4|P4a|P4b|ALL)
        [ "$2" = "$FROM" ] && { echo "That's you." >&2; exit 1; }
        url=$(new_thread "$2" "[${FROM}→${2}] ✅ READY: $(printf '%s' "$what" | head -1 | cut -c1-70)" "✅ ${what}

${ref}" ready); echo "sent: $url";;
      *)
        n="$2"
        gh api "repos/$REPO/issues/$n/comments" -f body="✅ DONE: ${what}

${ref}$(sig)" >/dev/null
        gh api "repos/$REPO/issues/$n/labels" -f "labels[]=ready" >/dev/null 2>&1 || true
        address_other "$n"
        gh api -X PATCH "repos/$REPO/issues/$n" -f state=closed >/dev/null
        acked "$n"; echo "done + closed #$n ($ref)";;
    esac;;
  wait)
    need $# 3; valid_to "$2"; [ "$2" = "$FROM" ] && { echo "That's you." >&2; exit 1; }
    what="$(body_of "$3")"
    url=$(new_thread "$2" "[${FROM}→${2}] ⛔ BLOCKED, need: $(printf '%s' "$what" | head -1 | cut -c1-70)" "⛔ ${FROM} is blocked until this lands:

${what}

Please ack now (send ack <#> \"ETA\") and send done <#> when it's pushed." blocking)
    bash "$(dirname "$0")/status" blocked "waiting on $2: $(printf '%s' "$what" | head -1 | cut -c1-60)" >/dev/null 2>&1 || true
    echo "sent: $url"
    echo "You're marked blocked. Arm the watcher in the BACKGROUND so you wake when they answer: bash scripts/comms/inbox watch"
    echo "Meanwhile work on anything not blocked (or stub against the contract).";;
  blast)
    need $# 2; subj="$2"; body="$(body_of "${3:-}")"
    url=$(new_thread ALL "[📢 ${FROM}→ALL] $subj" "📢 **ANNOUNCEMENT**

${body}" announce); echo "blasted: $url";;
  close)
    need $# 2; n="$2"; body="${3:-resolved}"
    gh api "repos/$REPO/issues/$n/comments" -f body="Resolved: ${body}$(sig)" >/dev/null
    address_other "$n"
    gh api -X PATCH "repos/$REPO/issues/$n" -f state=closed >/dev/null
    acked "$n"; echo "closed #$n";;
  list)
    for l in $(my_labels "$FROM"); do
      gh api -X GET "repos/$REPO/issues" -f labels="$l" -f state=open \
        --jq '.[] | select(.pull_request==null) | "#\(.number)  \(.title)  (updated \(.updated_at))"'
    done;;
  ping)
    need $# 2; valid_to "$2"
    exec bash "$0" "$2" "ping from $FROM" "Comms test from $FROM. Agent: reply with: bash scripts/comms/send close <this #> \"pong from <your pipeline>\"";;
  P1|P2|P3|P4|P4a|P4b|ALL)
    need $# 2; to="$1"; subj="$2"; body="$(body_of "${3:-}")"
    [ "$to" = "$FROM" ] && { echo "That's you ($FROM). Pick another pipeline." >&2; exit 1; }
    url=$(gh api "repos/$REPO/issues" -f title="[${FROM}→${to}] $subj" -f body="${body}$(sig)" \
          -f "labels[]=to:$to" -f "labels[]=from:$FROM" --jq '.html_url')
    echo "sent: $url";;
  *) sed -n '2,14p' "$0"; exit 1;;
esac
