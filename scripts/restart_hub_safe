#!/usr/bin/env bash
# Restart the hub ONLY when no call is live. Reads GET /demo/status (flags.active_calls = calls with an open media session).
# Refuses (exit 2) and prints the call-id prefixes while active_calls>0; --force overrides. --check = only report, never restart.
# Usage: scripts/restart_hub_safe [--force] [--check] [--port 8000]   (restart = stop the listener on the port, then exec scripts/run_hub)
set -u
FORCE=0; CHECK=0; PORT="${HUB_PORT:-8000}"
while [ $# -gt 0 ]; do case "$1" in --force) FORCE=1;; --check) CHECK=1;; --port) PORT="$2"; shift;; *) echo "unknown arg $1" >&2; exit 64;; esac; shift; done
cd "$(dirname "$0")/.."
OUT=$(curl -fsS -m 4 "http://127.0.0.1:$PORT/demo/status" 2>/dev/null) || OUT=""
if [ -n "$OUT" ]; then
  read -r N IDS LAST <<<"$(printf '%s' "$OUT" | python3 -c 'import sys,json,time
d=json.load(sys.stdin); f=d.get("flags",{}); n=f.get("active_calls",0); t=f.get("last_call_activity_ts")
print(n, ",".join(d.get("active_call_ids",[])) or "-", ("%ds ago"%(time.time()-t)) if t else "-")')"
  echo "hub on :$PORT: active_calls=$N ids=$IDS last_activity=$LAST"
  if [ "${N:-0}" -gt 0 ] && [ "$FORCE" != 1 ]; then
    echo "REFUSING to restart: $N live call(s) ($IDS). Wait for them to end, or re-run with --force." >&2; exit 2
  fi
else
  echo "no hub answering on :$PORT (status unreadable); nothing live to protect"
fi
[ "$CHECK" = 1 ] && exit 0
PIDS=$(lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null)
[ -n "$PIDS" ] && { echo "stopping hub pid(s): $PIDS"; kill $PIDS; for _ in $(seq 1 20); do lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 || break; sleep 0.5; done; }
exec scripts/run_hub
