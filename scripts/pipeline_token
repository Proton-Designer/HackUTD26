#!/usr/bin/env bash
# Shared PIPELINE_TOKEN with no human relay. SOURCE it after loading .env:   . scripts/pipeline_token
# If PIPELINE_TOKEN is unset and NVIDIA_API_KEY is set, exports
#   PIPELINE_TOKEN = first 32 hex of sha256("backfire-pipeline-token-v1:" + NVIDIA_API_KEY)
# Every machine with the team's NVIDIA key derives the same token; nothing secret goes to GitHub.
# An explicit PIPELINE_TOKEN (shell or .env) always wins. PIPELINE_TOKEN_DERIVE=0 turns derivation off.
# Check two machines match without revealing it:   bash scripts/pipeline_token --fingerprint   (8 hex of sha256(token))
if [ -z "${PIPELINE_TOKEN:-}" ] && [ -n "${NVIDIA_API_KEY:-}" ] && [ "${PIPELINE_TOKEN_DERIVE:-1}" != "0" ]; then
  PIPELINE_TOKEN="$(printf '%s' "backfire-pipeline-token-v1:${NVIDIA_API_KEY}" | sha256sum | cut -c1-32)"
  export PIPELINE_TOKEN
fi
if [ "${1:-}" = "--fingerprint" ]; then
  if [ -z "${PIPELINE_TOKEN:-}" ]; then
    cd "$(dirname "${BASH_SOURCE[0]}")/.." && { set -a; [ -f .env ] && . ./.env; set +a; }
    [ -n "${NVIDIA_API_KEY:-}" ] && PIPELINE_TOKEN="$(printf '%s' "backfire-pipeline-token-v1:${NVIDIA_API_KEY}" | sha256sum | cut -c1-32)"
  fi
  [ -n "${PIPELINE_TOKEN:-}" ] && printf 'pipeline token fingerprint: %s\n' "$(printf '%s' "$PIPELINE_TOKEN" | sha256sum | cut -c1-8)" || echo "no token (NVIDIA_API_KEY missing)"
fi
